# 统一编辑器基础格式（缩进/行尾/编码）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,ts,mts,vue,cjs}]
indent_style = space
indent_size = 2

[*.rs]
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,md}]
indent_style = space
indent_size = 2
